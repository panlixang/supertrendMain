# ── OKX 交易 API ─────────────────────────────────────────────
# 用法：复制成 .env 并把值换成你自己的（.env 已在 .gitignore，不会进版本库）
#     cp .env.example .env
#     然后 bash start.sh 会自动加载
#
# 模拟盘 key 与实盘 key 不通用，要分别创建：
#   模拟盘：OKX → 交易 → 模拟交易 → 个人中心 → 模拟盘API → 创建
#   实盘：  OKX → 个人中心 → API → 创建（务必绑定 IP）

OKX_API_KEY=54ac56d4-e52f-434b-8da1-152c91cc4721
OKX_API_SECRET=5018BA1C3308A9E7B198C9D5329F40AA
# ↑ 上面两个是占位示例，换成你自己的。passphrase 是你创建 key 时自己设的密码
OKX_API_PASSPHRASE=Plx549426.

# 1=模拟盘（默认，安全）  0=实盘（真实资金）
OKX_SIMULATED=0

# 美国/欧盟账户需要换域名，其余情况不用动
# OKX_BASE_URL=https://www.okx.com


# ── 微信推送（可选）───────────────────────────────────────────
# Server酱 https://sct.ftqq.com/ ，不填则静默禁用
# SERVERCHAN_SENDKEY=
# NOTIFY_TFS=15m,30m,1h,4h,1d      # 推送哪些周期
# NOTIFY_MIN_GRADE=B               # 只推 B 级及以上（A/B/C）
